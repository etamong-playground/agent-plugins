{
  "name": "onul-services",
  "displayName": "Onul Services",
  "owner": "Onul",
  "repository": "https://github.com/etamong-playground/agent-plugins",
  "plugins": [
    {
      "name": "pages",
      "displayName": "Pages",
      "version": "0.1.0",
      "description": "Publish private static sites and reports with Pages.",
      "homepage": "https://pages.onul.me",
      "endpoint": "https://pages.onul.me/mcp",
      "resource": "https://pages.onul.me",
      "clientId": "pages-native",
      "scopes": [
        "pages:read",
        "pages:write",
        "offline_access"
      ],
      "defaultPrompt": "Publish a private preview of my report with Pages.",
      "claudeAdapter": {
        "command": "pages",
        "args": [
          "mcp",
          "proxy"
        ],
        "originEnv": "PAGES_URL"
      }
    },
    {
      "name": "scheduler",
      "displayName": "Scheduler",
      "version": "0.1.0",
      "description": "Read your account, active organizations, and personal schedules.",
      "homepage": "https://scheduler.onul.me",
      "endpoint": "https://scheduler-api.onul.me/mcp",
      "resource": "https://scheduler-api.onul.me",
      "scopes": [
        "openid",
        "profile",
        "email",
        "offline_access",
        "scheduler:read"
      ],
      "defaultPrompt": "Show my Scheduler schedules for this week.",
      "capabilities": [
        "Read"
      ],
      "codexAdapter": {
        "command": "scheduler",
        "args": [
          "mcp"
        ]
      },
      "claudeAdapter": {
        "command": "scheduler",
        "args": [
          "mcp"
        ]
      }
    }
  ],
  "description": "Authenticated service connections and workflows for Onul services."
}
